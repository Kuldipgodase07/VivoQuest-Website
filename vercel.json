{
  "buildCommand": "cd vivoquest-frontend && npm install && npm run build",
  "outputDirectory": "vivoquest-frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!assets|fonts|images|screens|favicon.svg|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
